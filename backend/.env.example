# Database (optional). Omit to use SQLite at ./hackcanada.db
# DATABASE_URL=postgresql://user:pass@host/dbname

# Eleven Labs — voice input (STT). Get key at https://elevenlabs.io
# Free tier may be disabled (VPN/abuse detection); paid plan avoids this.
ELEVENLABS_API_KEY=

# Optional: different TTS voice (default is Rachel). Get IDs from Eleven Labs dashboard.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Backboard — AI triage. Optional for local dev.
# BACKBOARD_API_KEY=
# BACKBOARD_ASSISTANT_ID=

# Gemini — image analysis for injury/symptom photos. Optional.
# GEMINI_API_KEY=

# Only needed for production CORS when frontend is on another domain
# FRONTEND_ORIGIN=https://your-app.vercel.app
