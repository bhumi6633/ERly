# Local dev: omit DATABASE_URL to use SQLite. Production (e.g. Render): set via Render dashboard.
# DATABASE_URL=sqlite:///./hackcanada.db
# DATABASE_URL=postgresql://user:pass@host/db  # Render auto-sets this when linked to Postgres

# Optional: production frontend URL for CORS (e.g. https://erly.vercel.app)
# FRONTEND_ORIGIN=https://your-frontend.vercel.app

GEMINI_API_KEY=your_gemini_api_key_here
MAPBOX_TOKEN=your_mapbox_token_here
ENVIRONMENT=development
